// (D28) `ctrl CPHASE` would be a THREE-qubit gate: CPHASE is already
// two-qubit.  The controlled single-qubit PHASE is what the QFT needs.
gate qft[n: int](qs: Qubit[n]) {
    for i in 0..n {
        H qs[i];
        for j in (i + 1)..n {
            ctrl PHASE[pi / (1 << (j - i))] qs[j], qs[i];
        }
    }
    for i in 0..(n / 2) { SWAP qs[i], qs[n - 1 - i]; }
}

gate iqft[n: int](qs: Qubit[n]) { adj qft[n] qs; }